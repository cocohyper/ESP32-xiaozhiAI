FROM node:24-slim AS ui
WORKDIR /build/console/frontend
COPY console/frontend/package*.json ./
RUN npm ci
COPY console/frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /opt/xiaozhi
COPY console/ ./console/
COPY --from=ui /build/console/static/ ./console/static/
RUN mkdir -p /data
EXPOSE 8004
CMD ["python", "console/server.py", "--host", "0.0.0.0", "--port", "8004", "--data-dir", "/data"]
